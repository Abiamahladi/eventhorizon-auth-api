# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database ----------
# Local MongoDB:      mongodb://127.0.0.1:27017/eventhorizon
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>/eventhorizon
MONGO_URI=mongodb://127.0.0.1:27017/eventhorizon

# ---------- JWT (login tokens) ----------
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ---------- Email verification ----------
# How long a verification link stays valid (in hours)
VERIFICATION_TOKEN_EXPIRES_HOURS=24
# The link in the email points to your FRONTEND, which then calls
# GET /api/auth/verify-email?token=...  (or you can point it at the API directly)
FRONTEND_URL=http://localhost:3000

# ---------- SMTP (email sending) ----------
# Mailtrap (recommended for development): https://mailtrap.io
# Gmail: host smtp.gmail.com, port 587, use an App Password (not your normal password)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="EventHorizon <no-reply@eventhorizon.dev>"
